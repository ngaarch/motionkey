---
import Icon from "@/components/Icon.astro";
---

<div id="wizard" class="grad-border rounded-2xl">
  <noscript>
    <div class="mb-4 rounded-xl border border-amber-500/25 bg-amber-500/[0.07] p-4 text-[13.5px] leading-relaxed text-amber-200">
      <strong class="font-semibold">JavaScript diperlukan.</strong> Wizard unlock berjalan sepenuhnya di browser kamu — aktifkan JavaScript untuk melanjutkan.
    </div>
  </noscript>
  <div class="relative rounded-2xl bg-[var(--page)]/60 p-5 backdrop-blur-xl sm:p-8">
    <div id="wizard-progress" data-step="1" class="mb-8">
      <div class="flex items-center">
        <div class="step-node flex items-center gap-2.5" data-node="1">
          <span class="step-circle grid h-9 w-9 shrink-0 place-items-center rounded-full border text-[13px] font-semibold transition-all duration-300">
            <span class="step-num">1</span>
            <svg class="step-check hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <span class="hidden text-[13px] font-medium sm:block">Masukkan Email</span>
        </div>
        <div class="step-line mx-2 h-px flex-1 bg-[var(--line)] sm:mx-3"><div class="step-line-fill h-px w-0 bg-gradient-to-r from-accent-500 to-accent-600 transition-all duration-500"></div></div>
        <div class="step-node flex items-center gap-2.5" data-node="2">
          <span class="step-circle grid h-9 w-9 shrink-0 place-items-center rounded-full border text-[13px] font-semibold transition-all duration-300">
            <span class="step-num">2</span>
            <svg class="step-check hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <span class="hidden text-[13px] font-medium sm:block">Kirim Verifikasi</span>
        </div>
        <div class="step-line mx-2 h-px flex-1 bg-[var(--line)] sm:mx-3"><div class="step-line-fill h-px w-0 bg-gradient-to-r from-accent-500 to-accent-600 transition-all duration-500"></div></div>
        <div class="step-node flex items-center gap-2.5" data-node="3">
          <span class="step-circle grid h-9 w-9 shrink-0 place-items-center rounded-full border text-[13px] font-semibold transition-all duration-300">
            <span class="step-num">3</span>
            <svg class="step-check hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <span class="hidden text-[13px] font-medium sm:block">Unlock</span>
        </div>
      </div>
    </div>
    <p class="sr-only" data-progress-label aria-live="polite">Langkah 1 dari 3: Masukkan Email</p>

    <div id="step-panels">
      <section data-panel="1" class="space-y-5">
        <div>
          <h2 class="font-display text-lg font-semibold tracking-[-0.02em] text-[var(--text-1)]">Masukkan Email Kamu</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-[var(--text-2)]">
            Pakai email aktif yang bisa kamu buka inbox-nya. Link verifikasi Alight Motion akan dikirim ke email ini.
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="s1-email" class="text-[12.5px] font-medium text-[var(--text-2)]">Alamat email</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-3)]">
              <Icon name="mail" class="h-4.5 w-4.5" />
            </span>
            <input
              id="s1-email"
              type="email"
              inputmode="email"
              autocomplete="email"
              spellcheck="false"
              placeholder="nama@gmail.com"
              class="field h-[52px] w-full rounded-xl border pl-11 pr-11 font-mono text-[14px] text-[var(--text-1)] outline-none transition-all duration-200 placeholder:text-[var(--text-3)]"
            />
            <span id="s1-email-state" class="absolute right-4 top-1/2 hidden -translate-y-1/2"></span>
          </div>
          <p id="s1-email-msg" class="min-h-4 text-[12px] text-rose-400"></p>
        </div>

        <div id="s1-recent" hidden class="flex flex-wrap items-center gap-1.5">
          <span class="inline-flex items-center gap-1 text-[11px] font-medium uppercase tracking-[0.12em] text-[var(--text-3)]">
            <Icon name="clock" class="h-3 w-3" />
            Pakai sebelumnya
          </span>
        </div>

        <div id="s1-error" hidden role="alert" class="flex items-start gap-3 rounded-xl border border-rose-500/25 bg-rose-500/[0.07] p-4">
          <Icon name="circle-alert" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-rose-400" />
          <div class="min-w-0">
            <p id="s1-error-msg" class="text-[13.5px] font-medium text-rose-300"></p>
            <p id="s1-error-hint" class="mt-0.5 text-[12.5px] text-[var(--text-2)]"></p>
          </div>
        </div>

        <div class="flex flex-col gap-2.5 sm:flex-row">
          <button id="s1-next" type="button" disabled class="btn-main inline-flex h-[52px] flex-1 items-center justify-center gap-2.5 rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 text-[15px] font-semibold text-white shadow-[0_10px_30px_-10px_var(--glow)] transition-all duration-200 hover:brightness-110 active:scale-[0.98] disabled:pointer-events-none disabled:opacity-60">
            Lanjut Kirim Verifikasi
            <Icon name="arrow-right" class="btn-icon h-4 w-4" />
          </button>
        </div>
        <p class="text-center text-[11.5px] text-[var(--text-3)]">Butuh email khusus untuk verifikasi? Email biasa seperti Gmail sudah cukup.</p>
      </section>

      <section data-panel="2" hidden class="space-y-5">
        <div>
          <h2 class="font-display text-lg font-semibold tracking-[-0.02em] text-[var(--text-1)]">Kirim Link Verifikasi</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-[var(--text-2)]">
            Zelora akan mengirim email berisi link verifikasi ke alamat di bawah. Buka inbox kamu setelah ini.
          </p>
        </div>

        <div class="surface-card grad-border p-4 sm:p-5">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[0.12em] text-[var(--text-3)]">
              <Icon name="at-sign" class="h-3.5 w-3.5 text-accent-400" />
              Email tujuan
            </span>
            <button id="s2-change" type="button" class="inline-flex items-center gap-1 rounded-lg px-2 py-0.5 text-[11.5px] font-medium text-accent-300 transition-colors hover:text-accent-400">
              <Icon name="pencil" class="h-3 w-3" />
              Ubah
            </button>
          </div>
          <div class="mt-3 flex items-center gap-3">
            <code id="s2-email-display" class="min-w-0 flex-1 truncate font-mono text-[15px] font-medium text-[var(--text-1)] sm:text-base"></code>
          </div>
        </div>

        <div id="s2-error" hidden role="alert" class="flex items-start gap-3 rounded-xl border border-rose-500/25 bg-rose-500/[0.07] p-4">
          <Icon name="circle-alert" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-rose-400" />
          <div class="min-w-0">
            <p id="s2-error-msg" class="text-[13.5px] font-medium text-rose-300"></p>
            <p id="s2-error-hint" class="mt-0.5 text-[12.5px] text-[var(--text-2)]"></p>
          </div>
        </div>

        <div id="s2-success" hidden class="flex items-start gap-3 rounded-xl border border-mint-500/25 bg-mint-500/[0.07] p-4">
          <Icon name="mail-check" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-mint-300" />
          <div class="min-w-0">
            <p class="text-[13.5px] font-medium text-mint-300">Link verifikasi terkirim!</p>
            <p class="mt-0.5 text-[12.5px] leading-relaxed text-[var(--text-2)]">
              Buka inbox <span id="s2-success-email" class="font-mono text-[12px] text-[var(--text-1)]"></span>, lalu salin link verifikasi yang masuk (dimulai dengan <code class="font-mono text-[11.5px] text-accent-300">https://…</code>).
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-2.5 sm:flex-row">
          <button id="s2-back" type="button" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-xl border border-[var(--line)] px-5 text-[14px] font-medium text-[var(--text-2)] transition-all duration-200 hover:border-[var(--line-strong)] hover:text-[var(--text-1)] active:scale-[0.98]">
            <Icon name="arrow-left" class="h-4 w-4" />
            Kembali
          </button>
          <button id="s2-send" type="button" disabled class="btn-main inline-flex h-[52px] flex-1 items-center justify-center gap-2.5 rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 text-[15px] font-semibold text-white shadow-[0_10px_30px_-10px_var(--glow)] transition-all duration-200 hover:brightness-110 active:scale-[0.98] disabled:pointer-events-none disabled:opacity-60">
            <svg class="btn-spinner hidden h-4.5 w-4.5 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
            <Icon name="send" class="btn-icon h-4.5 w-4.5" />
            <span class="btn-label">Kirim Link Verifikasi</span>
          </button>
          <button id="s2-next" type="button" hidden class="inline-flex h-[52px] items-center justify-center gap-2 rounded-xl border border-accent-500/30 bg-accent-500/10 px-6 text-[14px] font-semibold text-accent-300 transition-all duration-200 hover:bg-accent-500/20 active:scale-[0.98]">
            Lanjut Unlock
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
        </div>
        <button id="s2-skip" type="button" class="mx-auto block text-[12px] text-[var(--text-3)] underline-offset-4 transition-colors hover:text-accent-300 hover:underline">
          Sudah punya link verifikasi? Langsung ke Step 3
        </button>
      </section>

      <section data-panel="3" hidden class="space-y-5">
        <div>
          <h2 class="font-display text-lg font-semibold tracking-[-0.02em] text-[var(--text-1)]">Unlock Premium</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-[var(--text-2)]">
            Tempel link verifikasi lengkap dari email (tombol/link yang kamu terima), lalu tekan unlock.
          </p>
        </div>

        <div class="space-y-1.5">
          <label for="s3-email" class="text-[12.5px] font-medium text-[var(--text-2)]">Alamat email</label>
          <input
            id="s3-email"
            type="email"
            inputmode="email"
            autocomplete="email"
            spellcheck="false"
            placeholder="nama@gmail.com"
            class="field h-[52px] w-full rounded-xl border px-4 font-mono text-[14px] text-[var(--text-1)] outline-none transition-all duration-200 placeholder:text-[var(--text-3)]"
          />
          <p id="s3-email-msg" class="min-h-4 text-[12px] text-rose-400"></p>
        </div>

        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="s3-link" class="text-[12.5px] font-medium text-[var(--text-2)]">Link verifikasi dari email</label>
            <button id="s3-paste" type="button" class="inline-flex items-center gap-1 text-[11.5px] text-accent-300 transition-colors hover:text-accent-400">
              <Icon name="clipboard-copy" class="h-3 w-3" />
              Tempel dari clipboard
            </button>
          </div>
          <textarea
            id="s3-link"
            rows="3"
            spellcheck="false"
            placeholder="https://…/__/auth/action?mode=verifyEmail&oobCode=…"
            class="field w-full resize-none rounded-xl border px-4 py-3.5 font-mono text-[13px] leading-relaxed text-[var(--text-1)] outline-none transition-all duration-200 placeholder:text-[var(--text-3)]"
          ></textarea>
          <p id="s3-link-msg" class="min-h-4 text-[12px] text-rose-400"></p>
        </div>

        <div id="s3-error" hidden role="alert" class="flex items-start gap-3 rounded-xl border border-rose-500/25 bg-rose-500/[0.07] p-4">
          <Icon name="triangle-alert" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-rose-400" />
          <div class="min-w-0">
            <p id="s3-error-msg" class="text-[13.5px] font-medium text-rose-300"></p>
            <p id="s3-error-hint" class="mt-0.5 text-[12.5px] text-[var(--text-2)]"></p>
          </div>
        </div>

        <div class="flex flex-col gap-2.5 sm:flex-row">
          <button id="s3-back" type="button" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-xl border border-[var(--line)] px-5 text-[14px] font-medium text-[var(--text-2)] transition-all duration-200 hover:border-[var(--line-strong)] hover:text-[var(--text-1)] active:scale-[0.98]">
            <Icon name="arrow-left" class="h-4 w-4" />
            Kembali
          </button>
          <button id="s3-unlock" type="button" disabled class="btn-main inline-flex h-[52px] flex-1 items-center justify-center gap-2.5 rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 text-[15px] font-semibold text-white shadow-[0_10px_30px_-10px_var(--glow)] transition-all duration-200 hover:brightness-110 active:scale-[0.98] disabled:pointer-events-none disabled:opacity-60">
            <svg class="btn-spinner hidden h-4.5 w-4.5 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
            <Icon name="lock-open" class="btn-icon h-4.5 w-4.5" />
            <span class="btn-label">Unlock Premium Sekarang</span>
          </button>
        </div>
      </section>
    </div>

    <div id="wizard-success" hidden class="flex flex-col items-center py-6 text-center">
      <div class="relative">
        <div class="absolute inset-0 -m-6 rounded-full bg-mint-400/10 blur-2xl"></div>
        <span class="relative grid h-20 w-20 place-items-center rounded-full border border-mint-400/30 bg-mint-400/10 animate-pop-in">
          <svg class="h-10 w-10 text-mint-300" viewBox="0 0 52 52" fill="none">
            <circle class="check-circle" cx="26" cy="26" r="23" stroke="currentColor" stroke-opacity="0.3" stroke-width="2.5"></circle>
            <path class="check-mark animate-check-draw" d="M15 27l7.5 7.5L38 19" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="40" stroke-dashoffset="40"></path>
          </svg>
        </span>
      </div>
      <h2 class="font-display mt-6 text-2xl font-bold tracking-[-0.02em] text-[var(--text-1)]">Premium <span class="text-gradient-party">Unlocked!</span></h2>
      <p class="mt-2 max-w-sm text-[13.5px] leading-relaxed text-[var(--text-2)]">
        Selamat! Akun <span id="ws-email" class="font-mono text-[12.5px] text-mint-300"></span> sudah dipromosikan jadi Premium. Buka Alight Motion dan nikmati semua fiturnya.
      </p>
      <div id="ws-meta" class="mt-3 inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--card)] px-3 py-1 text-[11.5px] text-[var(--text-3)]"></div>
      <div class="mt-7 flex flex-col gap-2.5 sm:flex-row">
        <button id="ws-again" type="button" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 px-6 text-[14px] font-semibold text-white shadow-[0_10px_30px_-10px_var(--glow)] transition-all duration-200 hover:brightness-110 active:scale-[0.98]">
          <Icon name="rotate-ccw" class="h-4 w-4" />
          Unlock Lagi
        </button>
        <button id="ws-share" type="button" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-xl border border-[var(--line)] px-6 text-[14px] font-medium text-[var(--text-2)] transition-all duration-200 hover:border-[var(--line-strong)] hover:text-[var(--text-1)] active:scale-[0.98]">
          <Icon name="check-check" class="h-4 w-4" />
          Bagikan / Salin Ringkasan
        </button>
        <button id="ws-done" type="button" class="inline-flex h-[52px] items-center justify-center gap-2 rounded-xl border border-[var(--line)] px-6 text-[14px] font-medium text-[var(--text-2)] transition-all duration-200 hover:border-[var(--line-strong)] hover:text-[var(--text-1)] active:scale-[0.98]">
          Selesai
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .step-circle {
    border-color: var(--line);
    background: var(--card);
    color: var(--text-3);
  }
  .step-node[data-state="current"] .step-circle {
    border-color: transparent;
    background: linear-gradient(135deg, var(--color-accent-500), var(--color-accent-700));
    color: #fff;
    box-shadow: 0 0 0 5px var(--glow-soft), 0 8px 20px -8px var(--glow);
    animation: pulse-ring 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .step-node[data-state="current"] .step-circle ~ * ,
  .step-node[data-state="current"] span:last-child {
    color: var(--text-1);
  }
  .step-node[data-state="done"] .step-circle {
    border-color: var(--color-mint-500);
    background: color-mix(in srgb, var(--color-mint-500) 14%, transparent);
    color: var(--color-mint-300);
  }
  .step-node[data-state="pending"] {
    opacity: 0.55;
  }
  .field {
    background: var(--input-bg);
    border-color: var(--line);
  }
  .field:focus {
    border-color: var(--color-accent-500);
    box-shadow: 0 0 0 3.5px var(--glow-soft);
  }
  .field[data-invalid="true"] {
    border-color: color-mix(in srgb, #f43f5e 55%, transparent);
  }
  .field[data-valid="true"] {
    border-color: color-mix(in srgb, var(--color-mint-500) 45%, transparent);
  }
</style>

<script>
  import { sendVerificationLink, unlockPremium } from "@/lib/api";
  import { addHistory, getLastEmail, getRecentEmails, setLastEmail } from "@/lib/storage";
  import { toast } from "@/lib/toast";
  import { confettiBurst } from "@/lib/confetti";
  import { extractLink, isValidVerifyLink } from "@/lib/utils";
  import { z } from "zod";

  const emailSchema = z.email({ message: "Format email tidak valid" });
  const linkSchema = z.url({ message: "Tempel link verifikasi lengkap (dimulai dengan https://)" });

  const progress = document.getElementById("wizard-progress")!;
  const panels = document.querySelectorAll<HTMLElement>("#step-panels [data-panel]");
  const successView = document.getElementById("wizard-success")!;

  const state = { step: 1, email: "", link: "", sent: false, unlocked: false };

  const $ = (id: string) => document.getElementById(id)!;

  function setLoading(btn: HTMLButtonElement, loading: boolean) {
    btn.disabled = loading || btn.dataset.permanentlyDisabled === "true";
    btn.querySelector<SVGElement>(".btn-spinner")?.classList.toggle("hidden", !loading);
    btn.querySelector<SVGElement>(".btn-icon")?.classList.toggle("hidden", loading);
  }

  function setPanel(step: number) {
    state.step = step;
    progress.dataset.step = String(step);
    panels.forEach((p) => {
      const show = p.dataset.panel === String(step);
      if (show && p.hidden) {
        p.hidden = false;
        p.classList.remove("animate-pop-in");
        void p.offsetWidth;
        p.classList.add("animate-pop-in");
      } else if (!show) {
        p.hidden = true;
      }
    });
    document.querySelectorAll<HTMLElement>("#wizard-progress .step-node").forEach((node) => {
      const n = Number(node.dataset.node);
      const st = n < step || (n === 3 && state.unlocked) ? "done" : n === step ? "current" : "pending";
      node.dataset.state = st;
      node.querySelector<SVGElement>(".step-check")?.classList.toggle("hidden", st !== "done");
      node.querySelector<HTMLElement>(".step-num")?.classList.toggle("hidden", st === "done");
      node.querySelector<HTMLElement>(".step-circle")?.classList.toggle("animate-pulse-ring", st === "current");
    });
    document.querySelectorAll<HTMLElement>("#wizard-progress .step-line-fill").forEach((fill, i) => {
      fill.style.width = i + 1 < step ? "100%" : "0%";
    });
    const stepNames = ["", "Masukkan Email", "Kirim Verifikasi", "Unlock"];
    const progressLabel = document.querySelector<HTMLElement>("[data-progress-label]");
    if (progressLabel) progressLabel.textContent = `Langkah ${step} dari 3: ${stepNames[step] ?? ""}`;
    if (step === 2) $("s2-email-display").textContent = state.email;
    syncUrl(step);
  }

  function markField(input: HTMLInputElement | HTMLTextAreaElement, validity: "none" | "valid" | "invalid", msgEl?: HTMLElement, msg = "") {
    input.dataset.invalid = validity === "invalid" ? "true" : "false";
    input.dataset.valid = validity === "valid" ? "true" : "false";
    if (msgEl) msgEl.textContent = msg;
  }

  function showInline(prefix: string, message: string, hint?: string) {
    const box = $(`${prefix}-error`);
    box.hidden = false;
    $(`${prefix}-error-msg`).textContent = message;
    $(`${prefix}-error-hint`).textContent = hint ?? "";
  }
  function hideInline(prefix: string) {
    $(`${prefix}-error`).hidden = true;
  }

  function recordHistory(kind: "send-link" | "unlock", status: "success" | "failed", email: string, detail: string, responseTime: string, link?: string) {
    addHistory({ kind, status, email, detail, responseTime, link });
    window.dispatchEvent(new CustomEvent("mk:history-changed"));
  }

  function humanTime(ms: number): string {
    return ms < 1000 ? `${Math.round(ms)}ms` : `${(ms / 1000).toFixed(1)}s`;
  }

  const s1Email = $("s1-email") as HTMLInputElement;
  const s1Next = $("s1-next") as HTMLButtonElement;

  function updateS1State() {
    const v = s1Email.value.trim();
    const parsed = emailSchema.safeParse(v);
    markField(s1Email, v === "" ? "none" : parsed.success ? "valid" : "invalid", $("s1-email-msg"), v === "" || parsed.success ? "" : "Format email belum benar");
    s1Next.disabled = !parsed.success;
  }
  s1Email.addEventListener("input", updateS1State);

  const recentWrap = $("s1-recent");
  function renderRecentEmails() {
    const recents = getRecentEmails();
    if (recents.length === 0) return;
    recentWrap.hidden = false;
    recents.forEach((email) => {
      if (recentWrap.querySelector(`[data-recent-email="${CSS.escape(email)}"]`)) return;
      const chip = document.createElement("button");
      chip.type = "button";
      chip.setAttribute("data-recent-email", email);
      chip.className =
        "group inline-flex max-w-[220px] items-center gap-1.5 rounded-full border border-[var(--line)] bg-[var(--input-bg)] px-3 py-1.5 font-mono text-[11.5px] text-[var(--text-2)] transition-all duration-200 hover:border-accent-500/40 hover:bg-accent-500/10 hover:text-accent-300 active:scale-95";
      chip.innerHTML = `
        <svg class="h-3 w-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path></svg>
        <span class="truncate">${email.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c)}</span>`;
      chip.addEventListener("click", () => {
        s1Email.value = email;
        updateS1State();
        const r = s1Email.getBoundingClientRect();
        confettiBurst({ x: r.left + r.width / 2, y: r.top });
        toast({ title: "Email terpasang", description: email, variant: "success" });
      });
      recentWrap.appendChild(chip);
    });
  }
  renderRecentEmails();

  s1Next.addEventListener("click", () => {
    const email = s1Email.value.trim();
    if (!emailSchema.safeParse(email).success) return;
    state.email = email;
    setLastEmail(email);
    updateS3State();
    setPanel(2);
  });

  const s2Send = $("s2-send") as HTMLButtonElement;

  s2Send.addEventListener("click", async () => {
    const email = state.email;
    if (!emailSchema.safeParse(email).success) {
      setPanel(1);
      return;
    }
    setLoading(s2Send, true);
    $("s2-success").hidden = true;
    hideInline("s2");
    try {
      const res = await sendVerificationLink(email);
      if (!res.ok) throw res.error;
      state.sent = true;
      setLastEmail(email);
      $("s2-success-email").textContent = email;
      $("s2-success").hidden = false;
      $("s2-next").hidden = false;
      recordHistory("send-link", "success", email, "Link verifikasi terkirim", humanTime(res.meta.durationMs));
      toast({ title: "Link verifikasi terkirim", description: `Cek inbox ${email}`, variant: "success" });
      startCooldown();
    } catch (err) {
      const e = err as { message: string; hint?: string };
      showInline("s2", e.message ?? "Gagal mengirim link.", e.hint);
      recordHistory("send-link", "failed", email, e.message ?? "Gagal kirim link", humanTime(0));
      toast({ title: "Gagal mengirim link", description: e.message, variant: "error" });
    } finally {
      setLoading(s2Send, false);
      tickCooldown();
    }
  });

  $("s2-back").addEventListener("click", () => setPanel(1));
  $("s2-change").addEventListener("click", () => setPanel(1));
  $("s2-next").addEventListener("click", () => {
    ($("s3-email") as HTMLInputElement).value = state.email;
    updateS3State();
    setPanel(3);
  });
  $("s2-skip").addEventListener("click", () => {
    if (!emailSchema.safeParse(state.email).success) {
      setPanel(1);
      return;
    }
    ($("s3-email") as HTMLInputElement).value = state.email;
    updateS3State();
    setPanel(3);
  });

  const s3Email = $("s3-email") as HTMLInputElement;
  const s3Link = $("s3-link") as HTMLTextAreaElement;
  const s3Unlock = $("s3-unlock") as HTMLButtonElement;

  function updateS3State() {
    const emailOk = emailSchema.safeParse(s3Email.value.trim()).success;
    const raw = extractLink(s3Link.value);
    const linkOk = linkSchema.safeParse(raw).success && isValidVerifyLink(raw);
    markField(s3Email, s3Email.value.trim() === "" ? "none" : emailOk ? "valid" : "invalid", $("s3-email-msg"), s3Email.value.trim() === "" || emailOk ? "" : "Format email belum benar");
    markField(s3Link, s3Link.value.trim() === "" ? "none" : linkOk ? "valid" : "invalid", $("s3-link-msg"), s3Link.value.trim() === "" || linkOk ? "" : "Link belum valid — pastikan lengkap dari email");
    s3Unlock.disabled = !(emailOk && linkOk);
  }
  s3Email.addEventListener("input", () => {
    state.email = s3Email.value.trim();
    updateS3State();
  });
  s3Link.addEventListener("input", updateS3State);

  $("s3-paste").addEventListener("click", async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text) {
        s3Link.value = text;
        updateS3State();
        toast({ title: "Link ditempel dari clipboard", variant: "info" });
      }
    } catch {
      toast({ title: "Tidak bisa membaca clipboard", description: "Tempel manual dengan Ctrl/Cmd+V", variant: "error" });
    }
  });

  $("s3-back").addEventListener("click", () => setPanel(2));

  s3Unlock.addEventListener("click", async () => {
    const email = s3Email.value.trim();
    const link = extractLink(s3Link.value);
    if (!emailSchema.safeParse(email).success || !linkSchema.safeParse(link).success) return;
    setLoading(s3Unlock, true);
    hideInline("s3");
    try {
      const res = await unlockPremium(email, link);
      if (!res.ok) throw res.error;
      state.unlocked = true;
      setLastEmail(email);
      recordHistory("unlock", "success", email, "Premium aktif", humanTime(res.meta.durationMs), link);
      $("ws-email").textContent = email;
      $("ws-meta").textContent = `Response ${humanTime(res.meta.durationMs)} · ${new Date().toLocaleString("id-ID")}`;
      panels.forEach((p) => (p.hidden = true));
      progress.dataset.step = "3";
      successView.hidden = false;
      successView.classList.add("animate-pop-in");
      setTimeout(() => {
        const r = successView.getBoundingClientRect();
        confettiBurst({ x: r.left + r.width / 2, y: Math.max(120, r.top + 80) });
      }, 250);
      toast({ title: "Premium berhasil diaktifkan", description: "Selamat menikmati fitur premium!", variant: "success", duration: 6000 });
    } catch (err) {
      const e = err as { message: string; hint?: string; code?: string };
      showInline("s3", e.message ?? "Unlock gagal.", e.hint);
      recordHistory("unlock", "failed", email, e.message ?? "Unlock gagal", "-", link);
      toast({ title: "Unlock gagal", description: e.message, variant: "error" });
      if (e.code === "INVALID_OOB_CODE") {
        toast({ title: "Saran", description: "Kirim ulang link verifikasi baru di Step 2", variant: "info" });
      }
    } finally {
      setLoading(s3Unlock, false);
    }
  });

  function resetWizard(keepEmail: boolean) {
    state.sent = false;
    state.unlocked = false;
    if (!keepEmail) {
      state.email = "";
      s1Email.value = "";
      ($("s3-email") as HTMLInputElement).value = "";
      $("s2-email-display").textContent = "";
    }
    ($("s3-link") as HTMLTextAreaElement).value = "";
    $("s2-success").hidden = true;
    $("s2-next").hidden = true;
    hideInline("s1");
    hideInline("s2");
    hideInline("s3");
    successView.hidden = true;
    successView.classList.remove("animate-pop-in");
    setPanel(1);
    updateS1State();
    updateS3State();
  }

  $("ws-again").addEventListener("click", () => resetWizard(true));
  $("ws-done").addEventListener("click", () => resetWizard(false));

  const COOLDOWN_MS = 30_000;
  const COOLDOWN_KEY = "mk:cooldown-send";
  let cooldownTimer = 0;

  function startCooldown() {
    try {
      localStorage.setItem(COOLDOWN_KEY, String(Date.now() + COOLDOWN_MS));
    } catch {
      /* noop */
    }
    tickCooldown();
  }

  function setSendDisabled() {
    s2Send.disabled = !emailSchema.safeParse(state.email).success || s2Send.dataset.cooldown === "true";
  }

  function tickCooldown() {
    window.clearInterval(cooldownTimer);
    const label = s2Send.querySelector<HTMLElement>(".btn-label");
    let remaining = 0;
    try {
      remaining = Math.max(0, Number(localStorage.getItem(COOLDOWN_KEY) ?? 0) - Date.now());
    } catch {
      /* noop */
    }
    if (remaining <= 0) {
      delete s2Send.dataset.cooldown;
      if (label) label.textContent = "Kirim Link Verifikasi";
      setSendDisabled();
      return;
    }
    s2Send.dataset.cooldown = "true";
    s2Send.disabled = true;
    if (label) label.textContent = `Tunggu ${Math.ceil(remaining / 1000)} dtk`;
    cooldownTimer = window.setInterval(() => {
      let left = 0;
      try {
        left = Math.max(0, Number(localStorage.getItem(COOLDOWN_KEY) ?? 0) - Date.now());
      } catch {
        /* noop */
      }
      if (left <= 0) {
        window.clearInterval(cooldownTimer);
        delete s2Send.dataset.cooldown;
        if (label) label.textContent = "Kirim Link Verifikasi";
        setSendDisabled();
        return;
      }
      if (label) label.textContent = `Tunggu ${Math.ceil(left / 1000)} dtk`;
    }, 1000);
  }

  function syncUrl(step: number) {
    const p = new URLSearchParams(window.location.search);
    if (state.email) p.set("email", state.email);
    else p.delete("email");
    p.set("step", String(step));
    const qs = p.toString();
    window.history.replaceState(null, "", qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
  }

  document.getElementById("ws-share")?.addEventListener("click", () => {
    const text = `Alight Motion Premium aktif untuk ${state.email}\nWaktu: ${new Date().toLocaleString("id-ID")}\nCoba sendiri: ${window.location.origin}/unlock`;
    const nav = navigator as Navigator & { share?: (d: { title: string; text: string }) => Promise<void> };
    if (nav.share) {
      nav.share({ title: "Premium Unlocked — MotionKey", text }).catch(() => {});
    } else {
      navigator.clipboard
        .writeText(text)
        .then(() => toast({ title: "Ringkasan disalin", description: "Siap dibagikan", variant: "success" }))
        .catch(() => toast({ title: "Gagal menyalin ringkasan", variant: "error" }));
    }
  });

  const urlParams = new URLSearchParams(window.location.search);
  const initialEmail = (urlParams.get("email") ?? getLastEmail()).trim();
  if (emailSchema.safeParse(initialEmail).success) {
    state.email = initialEmail;
    s1Email.value = initialEmail;
    s3Email.value = initialEmail;
  }
  const initialStep = Math.min(Math.max(Number(urlParams.get("step") ?? "1") || 1, 1), 3);
  updateS1State();
  updateS3State();
  tickCooldown();
  setPanel(initialStep);
</script>
