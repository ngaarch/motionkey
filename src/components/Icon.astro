import LoaderCircle from "lucide-static/dist/esm/icons/loader-circle.mjs";
import LockOpen from "lucide-static/dist/esm/icons/lock-open.mjs";
import Mail from "lucide-static/dist/esm/icons/mail.mjs";
import MailCheck from "lucide-static/dist/esm/icons/mail-check.mjs";
import MailOpen from "lucide-static/dist/esm/icons/mail-open.mjs";
import Menu from "lucide-static/dist/esm/icons/menu.mjs";
import MessageCircle from "lucide-static/dist/esm/icons/message-circle.mjs";
import Monitor from "lucide-static/dist/esm/icons/monitor.mjs";
import Moon from "lucide-static/dist/esm/icons/moon.mjs";
import MousePointerClick from "lucide-static/dist/esm/icons/mouse-pointer-click.mjs";
import PartyPopper from "lucide-static/dist/esm/icons/party-popper.mjs";
import Pencil from "lucide-static/dist/esm/icons/pencil.mjs";
import RotateCcw from "lucide-static/dist/esm/icons/rotate-ccw.mjs";
import Rocket from "lucide-static/dist/esm/icons/rocket.mjs";
import Search from "lucide-static/dist/esm/icons/search.mjs";
import Send from "lucide-static/dist/esm/icons/send.mjs";
import Server from "lucide-static/dist/esm/icons/server.mjs";
import ShieldCheck from "lucide-static/dist/esm/icons/shield-check.mjs";
import ShieldX from "lucide-static/dist/esm/icons/shield-x.mjs";
import Sparkles from "lucide-static/dist/esm/icons/sparkles.mjs";
import Sparkle from "lucide-static/dist/esm/icons/sparkle.mjs";
import Star from "lucide-static/dist/esm/icons/star.mjs";
import Sun from "lucide-static/dist/esm/icons/sun.mjs";
import Terminal from "lucide-static/dist/esm/icons/terminal.mjs";
import Timer from "lucide-static/dist/esm/icons/timer.mjs";
import Trash from "lucide-static/dist/esm/icons/trash.mjs";
import TriangleAlert from "lucide-static/dist/esm/icons/triangle-alert.mjs";
import WandSparkles from "lucide-static/dist/esm/icons/wand-sparkles.mjs";
import Wifi from "lucide-static/dist/esm/icons/wifi.mjs";
import WifiOff from "lucide-static/dist/esm/icons/wifi-off.mjs";
import X from "lucide-static/dist/esm/icons/x.mjs";
import Zap from "lucide-static/dist/esm/icons/zap.mjs";

const ICONS: Record<string, string> = {
  activity: Activity,
  "arrow-left": ArrowLeft,
  "arrow-right": ArrowRight,
  "at-sign": AtSign,
  "badge-check": BadgeCheck,
  "book-open": BookOpen,
  check: Check,
  "check-check": CheckCheck,
  "chevron-down": ChevronDown,
  "chevron-right": ChevronRight,
  "circle-alert": CircleAlert,
  "circle-check": CircleCheck,
  "circle-check-big": CircleCheckBig,
  "circle-x": CircleX,
  "clipboard-copy": ClipboardCopy,
  clock: Clock,
  command: Command,
  copy: Copy,
  "external-link": ExternalLink,
  gauge: Gauge,
  info: Info,
  inbox: Inbox,
  "key-round": KeyRound,
  layers: Layers,
  "life-buoy": LifeBuoy,
  link: Link,
  "link-2": Link2,
  "loader-circle": LoaderCircle,
  "lock-open": LockOpen,
  mail: Mail,
  "mail-check": MailCheck,
  "mail-open": MailOpen,
  menu: Menu,
  "message-circle": MessageCircle,
  monitor: Monitor,
  moon: Moon,
  "mouse-pointer-click": MousePointerClick,
  "party-popper": PartyPopper,
  pencil: Pencil,
  "rotate-ccw": RotateCcw,
  rocket: Rocket,
  search: Search,
  send: Send,
  server: Server,
  "shield-check": ShieldCheck,
  "shield-x": ShieldX,
  sparkles: Sparkles,
  sparkle: Sparkle,
  star: Star,
  sun: Sun,
  terminal: Terminal,
  timer: Timer,
  "trash-2": Trash,
  "triangle-alert": TriangleAlert,
  "wand-sparkles": WandSparkles,
  wifi: Wifi,
  "wifi-off": WifiOff,
  x: X,
  zap: Zap,
};

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "h-5 w-5", strokeWidth = 2 } = Astro.props;
const raw = ICONS[name] ?? "";
const cleaned = raw.replace(/class="[^"]*"/, "").replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`);
---

<Fragment set:html={cleaned.replace("<svg", `<svg aria-hidden="true" class="${className}"`)} />
