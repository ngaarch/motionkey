---
import Icon from "@/components/Icon.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  icon?: string;
  accent?: boolean;
}

const { eyebrow, title, description, icon, accent = false } = Astro.props;
---

<header class="relative mx-auto max-w-3xl overflow-visible px-4 pb-10 pt-14 text-center sm:px-6 sm:pt-20">
  <div class="pointer-events-none absolute left-1/2 top-0 h-64 w-[42rem] max-w-full -translate-x-1/2 overflow-hidden rounded-full">
    <div class="aurora-bg mx-auto h-full max-w-full opacity-40"></div>
  </div>
  {
    eyebrow && (
      <span class="reveal sticker relative mb-5 text-[12px] text-[var(--text-2)]">
        {icon && <Icon name={icon} class="h-3.5 w-3.5 text-accent-400" />}
        {eyebrow}
      </span>
    )
  }
  <h1
    class={`reveal relative font-display text-balance text-3xl font-bold tracking-[-0.03em] sm:text-[2.6rem] sm:leading-[1.12] ${accent ? "text-gradient-party" : "text-[var(--text-1)]"}`}
    style="--reveal-delay: 60ms"
  >
    {title}
  </h1>
  {
    description && (
      <p class="reveal relative mx-auto mt-4 max-w-xl text-pretty text-[15px] leading-relaxed text-[var(--text-2)]" style="--reveal-delay: 120ms">
        {description}
      </p>
    )
  }
</header>
