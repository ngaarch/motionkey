<div id="cmdk" hidden class="fixed inset-0 z-[95]" role="dialog" aria-modal="true" aria-label="Command palette">
  <div id="cmdk-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative mx-auto mt-[12vh] w-[calc(100vw-2rem)] max-w-lg overflow-hidden rounded-2xl border border-[var(--line-strong)] bg-[var(--surface)]/95 shadow-[0_40px_100px_-20px_rgba(0,0,0,0.7)] backdrop-blur-2xl animate-pop-in">
    <div class="flex items-center gap-3 border-b border-[var(--line)] px-4">
      <svg class="h-4 w-4 shrink-0 text-[var(--text-3)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input
        id="cmdk-input"
        type="text"
        placeholder="Ketik perintah atau cari halaman…"
        autocomplete="off"
        class="h-13 w-full bg-transparent py-4 text-sm text-[var(--text-1)] outline-none placeholder:text-[var(--text-3)]"
      />
      <kbd class="rounded border border-[var(--line)] bg-[var(--input-bg)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-3)]">ESC</kbd>
    </div>
    <div id="cmdk-list" class="max-h-[46vh] overflow-y-auto p-2" role="listbox"></div>
    <div class="flex items-center gap-4 border-t border-[var(--line)] px-4 py-2.5 text-[11px] text-[var(--text-3)]">
      <span class="inline-flex items-center gap-1.5"><kbd class="rounded border border-[var(--line)] bg-[var(--input-bg)] px-1 font-mono">↑↓</kbd> navigasi</span>
      <span class="inline-flex items-center gap-1.5"><kbd class="rounded border border-[var(--line)] bg-[var(--input-bg)] px-1 font-mono">↵</kbd> buka</span>
      <span class="ml-auto inline-flex items-center gap-1.5"><kbd class="rounded border border-[var(--line)] bg-[var(--input-bg)] px-1 font-mono">⌘K</kbd> toggle</span>
    </div>
  </div>
</div>

<script>
  import Fuse from "fuse.js";
  import { confettiBurst } from "@/lib/confetti";
  import { getLastEmail, clearHistory } from "@/lib/storage";
  import { toast } from "@/lib/toast";

  interface Item {
    label: string;
    hint: string;
    href?: string;
    action?: () => void;
    keywords?: string;
  }

  const palette = document.getElementById("cmdk")!;
  const input = document.getElementById("cmdk-input") as HTMLInputElement;
  const list = document.getElementById("cmdk-list")!;
  let activeIndex = 0;
  let filtered: Item[] = [];

  const items: Item[] = [
    { label: "Unlock Alight Motion Premium", hint: "Alur 3 langkah", href: "/unlock", keywords: "unlock premium wizard utama" },
    { label: "Beranda", hint: "Halaman utama", href: "/", keywords: "home landing awal" },
    { label: "Panduan Lengkap", hint: "Cara pakai step-by-step", href: "/guide", keywords: "guide tutorial cara pakai" },
    { label: "FAQ", hint: "Pertanyaan umum", href: "/faq", keywords: "faq bantuan pertanyaan" },
    { label: "Status API", hint: "Kesehatan endpoint", href: "/status", keywords: "status server health api" },
    {
      label: "Ganti Tema Gelap / Terang",
      hint: "Tindakan cepat",
      keywords: "theme dark light gelap terang mode",
      action: () => {
        const next = document.documentElement.classList.contains("light") ? "dark" : "light";
        window.dispatchEvent(new CustomEvent("set-theme", { detail: { theme: next } }));
      },
    },
    {
      label: "Buka Dokumentasi Zelora API",
      hint: "Tautan eksternal",
      href: "https://zelora-api.vercel.app",
      keywords: "docs zelora dokumentasi api",
    },
    {
      label: "Hujan Confetti",
      hint: "Tindakan cepat · karena kenapa tidak",
      keywords: "confetti hujan kertas meriah tes fun",
      action: () => {
        confettiBurst({ x: window.innerWidth / 2, y: window.innerHeight * 0.35 });
        toast({ title: "Selamat! Kamu menemukan easter egg", variant: "success" });
      },
    },
    {
      label: "Salin Email Terakhir Dipakai",
      hint: "Tindakan cepat",
      keywords: "salin copy email terakhir clipboard",
      action: () => {
        const email = getLastEmail();
        if (!email) {
          toast({ title: "Belum ada email tersimpan", description: "Isi email dulu di halaman Unlock", variant: "info" });
          return;
        }
        navigator.clipboard
          .writeText(email)
          .then(() => toast({ title: "Email disalin", description: email, variant: "success" }))
          .catch(() => toast({ title: "Gagal menyalin", variant: "error" }));
      },
    },
    {
      label: "Hapus Semua Riwayat",
      hint: "Tindakan cepat · butuh konfirmasi",
      keywords: "hapus riwayat clear history bersihkan",
      action: () => {
        window.dispatchEvent(
          new CustomEvent("confirm-request", {
            detail: { title: "Hapus riwayat dari palette?", description: "Semua riwayat aktivitas akan dihapus permanen.", confirmLabel: "Hapus" },
          }),
        );
        const onResult = (ev: Event) => {
          const { id, result } = (ev as CustomEvent<{ id: string; result: boolean }>).detail;
          if (id === "Hapus riwayat dari palette?") {
            window.removeEventListener("confirm-result", onResult);
            if (result) {
              clearHistory();
              window.dispatchEvent(new CustomEvent("mk:history-changed"));
              toast({ title: "Riwayat dihapus", variant: "success" });
            }
          }
        };
        window.addEventListener("confirm-result", onResult);
      },
    },
  ];

  const fuse = new Fuse(items, { keys: ["label", "hint", "keywords"], threshold: 0.35, ignoreLocation: true });

  const RECENT_KEY = "mk:recent-pages";
  function getRecents(): string[] {
    try {
      const raw = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]") as string[];
      return Array.isArray(raw) ? raw : [];
    } catch {
      return [];
    }
  }
  function trackVisit() {
    const match = items.find((i) => i.href === window.location.pathname);
    if (!match) return;
    const next = [window.location.pathname, ...getRecents().filter((p) => p !== window.location.pathname)].slice(0, 4);
    try {
      localStorage.setItem(RECENT_KEY, JSON.stringify(next));
    } catch {
      /* noop */
    }
  }
  trackVisit();

  function open() {
    palette.hidden = false;
    input.value = "";
    render(items);
    requestAnimationFrame(() => input.focus());
    document.body.style.overflow = "hidden";
  }

  function close() {
    palette.hidden = true;
    document.body.style.overflow = "";
  }

  function iconFor(item: Item): string {
    if (item.action) {
      const l = item.label.toLowerCase();
      if (l.includes("confetti")) {
        return '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5.8 11.3 2 22l10.7-3.79"></path><path d="M4 3h.01"></path><path d="M22 8h.01"></path><path d="M15 2h.01"></path><path d="M22 20h.01"></path><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"></path><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11c-.11.7-.72 1.22-1.43 1.22H17"></path><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98C9.52 4.9 9 5.52 9 6.23V7"></path><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z"></path></svg>';
      }
      if (l.includes("salin")) {
        return '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="14" height="14" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
      }
      if (l.includes("hapus")) {
        return '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>';
      }
      return '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>';
    }
    if (item.href?.startsWith("http")) {
      return '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>';
    }
    return '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>';
  }

  function render(results: Item[]) {
    list.textContent = "";
    if (results.length === 0) {
      filtered = [];
      list.innerHTML = '<div class="px-4 py-10 text-center text-sm text-[var(--text-3)]">Tidak ada hasil untuk pencarianmu.</div>';
      return;
    }

    const recents = getRecents();
    const isUnfiltered = results.length === items.length;
    let ordered: Item[] = results;
    const rows: Array<{ kind: "item"; item: Item } | { kind: "sep"; label?: string }> = [];

    if (isUnfiltered && recents.length > 0) {
      const recentItems = recents
        .map((p) => items.find((i) => i.href === p))
        .filter((i): i is Item => Boolean(i) && i !== undefined);
      if (recentItems.length > 0) {
        const rest = results.filter((r) => !recents.includes(r.href ?? "\u0000"));
        ordered = [...recentItems, ...rest];
        rows.push({ kind: "sep", label: "Terakhir dibuka" });
        recentItems.forEach((item) => rows.push({ kind: "item", item }));
        if (rest.length > 0) {
          rows.push({ kind: "sep" });
          rest.forEach((item) => rows.push({ kind: "item", item }));
        }
      } else {
        results.forEach((item) => rows.push({ kind: "item", item }));
      }
    } else {
      results.forEach((item) => rows.push({ kind: "item", item }));
    }

    filtered = ordered;
    rows.forEach((row) => {
      if (row.kind === "sep") {
        if (row.label) {
          const header = document.createElement("div");
          header.className = "px-3.5 pb-1.5 pt-2 text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[var(--text-3)]";
          header.textContent = row.label;
          list.appendChild(header);
        } else {
          const hr = document.createElement("div");
          hr.className = "mx-3.5 my-2 h-px bg-[var(--line)]";
          list.appendChild(hr);
        }
      } else {
        list.appendChild(makeRow(row.item, filtered.indexOf(row.item)));
      }
    });
    setActive(0);
  }

  function makeRow(item: Item, i: number): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.setAttribute("role", "option");
    btn.dataset.index = String(i);
    btn.className = `group flex w-full items-center gap-3 rounded-xl px-3.5 py-3 text-left transition-colors ${i === activeIndex ? "bg-accent-500/12 text-[var(--text-1)]" : "text-[var(--text-2)] hover:bg-[var(--card-hover)]"}`;
    btn.innerHTML = `
      <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-[var(--line)] bg-[var(--input-bg)] text-[var(--text-2)]">${iconFor(item)}</span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-[13.5px] font-medium">${item.label}</span>
        <span class="block truncate text-[11.5px] text-[var(--text-3)]">${item.hint}</span>
      </span>
      <svg class="h-3.5 w-3.5 shrink-0 opacity-0 transition-opacity group-data-[active=true]:opacity-60 ${i === activeIndex ? "opacity-60" : ""}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>`;
    btn.addEventListener("click", () => run(item));
    return btn;
  }

  function setActive(i: number) {
    activeIndex = Math.max(0, Math.min(filtered.length - 1, i));
    list.querySelectorAll("[role=option]").forEach((el, idx) => {
      const btn = el as HTMLElement;
      const on = idx === activeIndex;
      btn.dataset.active = String(on);
      btn.classList.toggle("bg-accent-500/12", on);
      btn.classList.toggle("text-[var(--text-1)]", on);
    });
    list.querySelector<HTMLElement>(`[data-index="${activeIndex}"]`)?.scrollIntoView({ block: "nearest" });
  }

  function run(item: Item) {
    close();
    if (item.action) {
      item.action();
      return;
    }
    if (item.href) {
      if (item.href.startsWith("http")) window.open(item.href, "_blank", "noopener");
      else window.location.href = item.href;
    }
  }

  window.addEventListener("open-cmdk", () => (palette.hidden ? open() : close()));
  document.getElementById("cmdk-backdrop")?.addEventListener("click", close);
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !palette.hidden) close();
  });

  input.addEventListener("input", () => {
    const q = input.value.trim();
    render(q ? fuse.search(q).map((r) => r.item) : items);
  });

  window.addEventListener("keydown", (e) => {
    if (palette.hidden) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === "Enter") {
      e.preventDefault();
      const item = filtered[activeIndex];
      if (item) run(item);
    }
  });
</script>
