---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["relative overflow-hidden rounded-lg bg-[var(--card-hover)]", className]}>
  <div class="absolute inset-0 -translate-x-full animate-shimmer bg-gradient-to-r from-transparent via-white/[0.06] to-transparent"></div>
</div>
