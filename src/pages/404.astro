---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout title="404 — Halaman Tidak Ditemukan" description="Halaman yang kamu cari tidak ada atau sudah dipindahkan.">
  <section class="relative flex min-h-[72vh] items-center justify-center overflow-hidden px-4">
    <div class="ambient-glow left-[15%] top-[10%] h-64 w-64 bg-accent-500/20 animate-float"></div>
    <div class="ambient-glow right-[10%] bottom-[12%] h-72 w-72 bg-accent-700/15 animate-float" style="animation-delay: -4s"></div>

    <div class="relative max-w-lg text-center">
      <p class="font-display text-gradient-party select-none text-[7rem] font-bold leading-none tracking-tighter sm:text-[9rem]">404</p>
      <h1 class="mt-2 font-display text-2xl font-bold tracking-[-0.02em] text-[var(--text-1)]">Halaman tidak ditemukan</h1>
      <p class="mx-auto mt-3 max-w-sm text-[14px] leading-relaxed text-[var(--text-2)]">
        Sepertinya link yang kamu buka salah alamat atau sudah dipindahkan. Tenang, pintu kembali ke tools utama tetap terbuka.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-2.5 sm:flex-row">
        <a href="/" class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 px-6 text-[14px] font-semibold text-white shadow-[0_10px_30px_-10px_var(--glow)] transition-all duration-200 hover:brightness-110 active:scale-[0.98] sm:w-auto">
          <Icon name="arrow-left" class="h-4 w-4" />
          Kembali ke Beranda
        </a>
        <a href="/unlock" class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-[var(--line)] px-6 text-[14px] font-medium text-[var(--text-2)] transition-all duration-200 hover:border-[var(--line-strong)] hover:text-[var(--text-1)] active:scale-[0.98] sm:w-auto">
          <Icon name="zap" class="h-4 w-4" />
          Buka Unlock Wizard
        </a>
      </div>

      <div class="mt-10 flex items-center justify-center gap-5 border-t border-[var(--line)] pt-6 text-[12.5px] text-[var(--text-3)]">
        <a href="/guide" class="transition-colors hover:text-accent-300">Panduan</a>
        <span class="h-3 w-px bg-[var(--line)]"></span>
        <a href="/faq" class="transition-colors hover:text-accent-300">FAQ</a>
        <span class="h-3 w-px bg-[var(--line)]"></span>
        <a href="/status" class="transition-colors hover:text-accent-300">Status</a>
      </div>
    </div>
  </section>
</BaseLayout>
