---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UnlockWizard from "@/components/unlock/UnlockWizard.astro";
import HistoryPanel from "@/components/unlock/HistoryPanel.astro";
import Icon from "@/components/Icon.astro";
---

<BaseLayout
  title="Unlock Wizard — 3 Langkah Menuju Premium"
  description="Masukkan email, kirim link verifikasi, dan unlock Alight Motion Premium lewat wizard interaktif yang memandu setiap langkah."
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[460px] overflow-hidden">
    <div class="aurora-bg opacity-40"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-[var(--page)]"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-12 sm:px-6">
    <div class="mb-10 max-w-2xl">
      <span class="sticker text-[12px] text-[var(--text-2)]">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-mint-400"></span>
        </span>
        Wizard Interaktif
      </span>
      <h1 class="reveal mt-5 font-display text-balance text-3xl font-bold tracking-[-0.03em] text-[var(--text-1)] sm:text-4xl">
        Unlock <span class="text-gradient-party">Alight Motion Premium</span>
      </h1>
      <p class="reveal mt-3 text-pretty text-[15px] leading-relaxed text-[var(--text-2)]" style="--reveal-delay: 80ms">
        Ikuti tiga langkah di bawah — setiap langkah divalidasi otomatis dan kamu bisa bolak-balik kapan saja.
      </p>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[1fr_360px]">
      <div class="space-y-6">
        <div class="reveal grad-border lock-tilt relative overflow-hidden rounded-2xl">
          <div class="relative flex items-center gap-5 overflow-hidden bg-gradient-to-br from-accent-500/[0.1] via-transparent to-punch-500/[0.08] p-5 sm:p-6">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl border border-accent-500/30 bg-[var(--card)] shadow-[0_14px_36px_-14px_var(--glow)]">
              <Icon name="lock-open" class="h-7 w-7 text-accent-300" />
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-fun text-[15px] font-semibold text-[var(--text-1)]">3 langkah → Premium aktif</p>
              <p class="mt-0.5 text-[12.5px] leading-relaxed text-[var(--text-2)]">Email kamu sendiri, tanpa login, tanpa syarat.</p>
            </div>
            <span class="hidden shrink-0 items-center gap-1.5 rounded-full border border-mint-500/25 bg-mint-500/10 px-2.5 py-1 text-[11px] font-medium text-mint-300 sm:inline-flex">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-live-ping rounded-full bg-mint-400"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-mint-400"></span>
              </span>
              API live
            </span>
          </div>
        </div>

        <UnlockWizard />
      </div>

      <div class="space-y-5 lg:sticky lg:top-24">
        <HistoryPanel />

        <section class="spotlight-card surface-card grain p-5">
          <h2 class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-1)]">
            <Icon name="life-buoy" class="h-4 w-4 text-accent-400" />
            Butuh bantuan?
          </h2>
          <ul class="space-y-3 text-[13px] leading-relaxed text-[var(--text-2)]">
            <li class="flex gap-2.5">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-mint-400" />
              Link verifikasi hanya berlaku sekali pakai — selalu pakai yang terbaru.
            </li>
            <li class="flex gap-2.5">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-mint-400" />
              Error kadaluarsa? Ulangi dari Step 2 untuk kirim link baru.
            </li>
            <li class="flex gap-2.5">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-mint-400" />
              Masih bingung? Baca <a href="/guide" class="font-medium text-accent-300 underline-offset-4 hover:underline">panduan lengkap</a> atau cek <a href="/faq" class="font-medium text-accent-300 underline-offset-4 hover:underline">FAQ</a>.
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
